{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__asana__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/asana-project-guard.py",
            "statusMessage": "Checking Asana project scope"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "agentic-bundle-aas-localization-international-growth@agentic-awesome-skills": true
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "agentic-awesome-skills": {
      "source": {
        "source": "github",
        "repo": "sickn33/agentic-awesome-skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.docker/config.json",
        "~/.kube/config",
        "~/.env",
        "~/SecondBrain"
      ]
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
